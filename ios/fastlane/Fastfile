# Build, sign (automatic, via App Store Connect API key) and upload 毎時ログ.
#
# Required environment variables:
#   ASC_KEY_ID, ASC_ISSUER_ID  App Store Connect API key (role: Admin — needed for cloud-managed distribution signing)
#   ASC_KEY_PATH               path to the AuthKey_XXXX.p8 file
#   APPLE_TEAM_ID              10-character Apple Developer Team ID
# Run `flutter build ios --release --no-codesign` first (the CI workflow does this).
default_platform(:ios)

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )
  end

  def signing_args
    "-allowProvisioningUpdates " \
      "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')} " \
      "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
  end

  desc "Archive and export a signed .ipa"
  lane :build do
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "maiji_log.ipa",
      xcargs: "#{signing_args} DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CODE_SIGN_STYLE=Automatic",
      # gym also passes xcargs to the export step, so the signing args must not be repeated there.
      export_options: { signingStyle: "automatic", teamID: ENV.fetch("APPLE_TEAM_ID") },
    )
  end

  desc "Upload a build to TestFlight"
  lane :beta do
    key = api_key
    build
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Create an internal TestFlight group that gets every build, and add all team users to it"
  lane :testers do
    api_key
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("App #{bundle_id} not found in App Store Connect") unless app

    group = app.get_beta_groups.find { |g| g.name == "自分" }
    unless group
      # fastlane's create_beta_group also sends public-link fields, which Apple rejects for internal groups.
      Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: { name: "自分", isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: "apps", id: app.id } } },
        },
      })
      group = app.get_beta_groups.find { |g| g.name == "自分" }
    end
    UI.success("Internal group: #{group.name} (all builds: #{group.has_access_to_all_builds})")

    Spaceship::ConnectAPI::User.all.each do |u|
      email = u.email || u.username
      next if email.to_s.empty?
      begin
        Spaceship::ConnectAPI.post_beta_tester_assignment(
          beta_group_ids: [group.id],
          attributes: { email: email, firstName: u.first_name.to_s, lastName: u.last_name.to_s },
        )
        UI.success("Added tester: #{u.first_name} #{u.last_name}")
      rescue => e
        UI.important("Tester #{u.first_name} #{u.last_name}: #{e.message.lines.first&.strip}")
      end
    end
  end

  desc "Upload build + store listing + screenshots; submit for review when SUBMIT=true"
  lane :release do
    key = api_key
    build
    upload_to_app_store(
      api_key: key,
      force: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      app_rating_config_path: "./fastlane/app_rating_config.json",
      run_precheck_before_submit: false,
      submit_for_review: ENV["SUBMIT"] == "true",
      automatic_release: false,
      app_review_information: {
        first_name: ENV["REVIEW_FIRST_NAME"],
        last_name: ENV["REVIEW_LAST_NAME"],
        phone_number: ENV["REVIEW_PHONE"],
        email_address: ENV["REVIEW_EMAIL"],
        demo_required: false,
        notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__)).strip,
      },
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
